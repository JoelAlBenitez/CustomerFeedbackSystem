<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CustomerFeedbackSystem.OLAP.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the build Catalyst.Models.Spanish 1.0.30952 was published against
         (it requires Catalyst >= 1.0.30950). Bumping only one of the pair drifts the
         model format away from the runtime that reads it. -->
    <PackageReference Include="Catalyst" Version="1.0.30950" />
    <PackageReference Include="Catalyst.Models.Spanish" Version="1.0.30952" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomerFeedbackSystem.OLAP.Core\CustomerFeedbackSystem.OLAP.Core.csproj" />
  </ItemGroup>

</Project>
